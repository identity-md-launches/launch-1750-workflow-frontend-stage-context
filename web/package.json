{
  "name": "loom-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@tanstack/react-query": "5.90.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.6",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
